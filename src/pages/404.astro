---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Page not found" noindex>
  <div class="wrap page-head fade" style="min-height:60vh">
    <span class="eyebrow">404</span>
    <h1 style="margin-top:12px">This page has gone missing.</h1>
    <p>It may have moved, or the link may be wrong.</p>
    <p style="margin-top:28px"><a class="btn" href={url()}>Back to the home page</a></p>
  </div>
</Base>
