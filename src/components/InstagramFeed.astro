---
import '../styles/instagram.css';
import { S, url, fmtDay, getInstagram, handleOf } from '../lib/site';
// "Latest on Instagram": the newest posts the society added in the admin. Each tile links to the real post.
const posts = await getInstagram(8);
const profile = S.social.instagram || '';
const handle = handleOf(profile);
const show = !!profile || posts.length > 0;
---
{show && (
<section class="ig" aria-labelledby="ig-title">
  <div class="wrap">
    <div class="ig-head">
      <div class="ig-who">
        <span class="ig-av"><img src={url('media/logo-eggplant.png')} width="44" height="44" alt="" /></span>
        <div>
          <h2 id="ig-title">Latest on Instagram</h2>
          {handle && <span class="ig-handle">@{handle}</span>}
        </div>
      </div>
      {profile && <a class="btn" href={profile} target="_blank" rel="noopener noreferrer">Follow us</a>}
    </div>

    {(posts.length > 0 || S.instagramFeed) && (
      <div class="ig-grid" data-feed={S.instagramFeed || undefined}>
        {posts.map((p) => (
          <a class="ig-tile" href={p.data.url} target="_blank" rel="noopener noreferrer">
            <span class="sr">{p.data.caption ? `${p.data.caption}. ` : ''}Instagram post by </span>
            {p.data.image
              ? <img src={url(p.data.image)} alt="" width="800" height="800" loading="lazy" decoding="async" />
              : <span class={`ig-fill ${p.data.theme}`}></span>}
            {p.data.count > 1 && <span class="ig-badge">1/{p.data.count}</span>}
            <span class="ig-meta">
              <span class="ig-mav"><img src={url('media/logo-eggplant.png')} width="40" height="40" alt="" /></span>
              <span class="ig-text">
                <b>{handle}</b>
                <time datetime={p.data.date} data-ago>{fmtDay(p.data.date)}</time>
              </span>
              <svg class="ig-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
)}
