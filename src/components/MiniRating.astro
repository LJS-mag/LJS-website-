---
import Stars from './Stars.astro';
import type { Rating } from '../lib/site';
const { rating } = Astro.props as { rating: Rating };
---
<div class="mini">
  {rating.n
    ? (<><Stars avg={rating.avg} /><span>{rating.avg.toFixed(1)} · {rating.n} review{rating.n > 1 ? 's' : ''}</span></>)
    : <span>No reviews yet</span>}
</div>
