---
import { url } from '../lib/site';
const { member } = Astro.props as { member: any };
const d = member.data;
const initials = (() => {
  const w = d.name.trim().split(/\s+/);
  return (w.length > 1 ? w[0][0] + w[w.length - 1][0] : d.name.slice(0, 2)).toUpperCase();
})();
---
<div class="person">
  <div class="av">
    {d.photo
      ? <img src={url(`media/team/${d.photo}`)} width="640" height="800" alt={`${d.name}, ${d.role}`} loading="lazy" />
      : initials}
  </div>
  <h3>{d.name}</h3>
  <div class="role">{d.role}</div>
  {d.bio && <p class="bio">{d.bio}</p>}
</div>
