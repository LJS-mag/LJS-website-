---
// Small logo marks for the footer links. Drawn as simple line icons that take the text colour.
const { name } = Astro.props as { name: 'instagram' | 'spotify' | 'substack' };
---
<svg class="soc-i" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" /></>)}
  {name === 'spotify' && (<><circle cx="12" cy="12" r="9" /><path d="M7.4 9.5c3.3-1 6.9-.7 9.6 1" /><path d="M8 12.6c2.7-.7 5.4-.4 7.7.9" /><path d="M8.7 15.5c2.1-.5 4.1-.3 5.8.6" /></>)}
  {name === 'substack' && (<><path d="M5 4.5h14" /><path d="M5 8.5h14" /><path d="M5 12.5h14v8l-7-4.3-7 4.3z" /></>)}
</svg>
